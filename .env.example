# Copia este archivo a .env en la raíz antes de ejecutar Docker Compose.
# Sustituye este ejemplo por un valor que use letras, números, puntos,
# guiones o guiones bajos, ya que se interpola en DATABASE_URL.
# Si pgdata ya existe, conserva la contraseña con la que se inicializó.
POSTGRES_PASSWORD=ejemplo_cambiar_antes_de_usar
